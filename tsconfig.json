{
  "files": [
    "crates/bun-runtime/packages/bun-types/bun.d.ts",
    "crates/bun-runtime/packages/bun-types/windows.d.ts",
    "crates/bun-runtime/packages/bun-tauri/js/api/global.d.ts"
  ],
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["packages/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "test/**/*.ts", "types/**/*.d.ts"],
  "exclude": [
    "crates/**",
    "crates/**",
    "packages/bun-engine/src/core/replica/**",
    "toolchains/**"
  ]
}
