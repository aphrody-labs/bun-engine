{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"],
  "exclude": [
    "crates/**",
    "plugins/emulation/rust/**",
    "src/console/vendor/**",
    "src/drivers/**",
    "src/gpu/**",
    "src/kernel/**",
    "src/ml/magika/**",
    "src/runtime/bun/**",
    "src/skills/replica/**",
    "toolchains/**"
  ]
}
