{
  "name": "@aphrody/bun-engine",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "bin": {
    "bep": "./src/bep.ts",
    "bun-engine": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "build": "bun run ./src/cli.ts build",
    "compile": "bun run ./src/cli.ts compile",
    "bep:compile": "bun run ./src/bep-build.ts",
    "check": "bun check --noEmit",
    "test": "bun test ./test",
    "workspace:test": "bun run ./src/cli.ts test",
    "ml:setup": "bun run ./src/cli.ts ml:setup",
    "ml:identify": "bun run ./src/cli.ts ml:identify",
    "skills": "bun run ./src/cli.ts skills",
    "web": "bun run ./src/cli.ts web",
    "probe": "bun run ./src/cli.ts probe",
    "qualify:fc27": "bun run ./src/cli.ts qualify 4080220",
    "android:test": "bun test ./plugins/android/packages/android-pipeline/tests",
    "console:manifest": "bun test ./test/console-catalog.test.ts",
    "native:test": "bun ./src/runtime/bun/scripts/build/rust/cargo-serial.ts --msvc test --workspace",
    "console:validate": "bun run ./src/console/validate.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
